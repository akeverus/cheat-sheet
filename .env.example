# Скопируй в .env и заполни.
# docker-compose автоматически подхватит этот файл.

# Один из ключей обязателен (если хочешь AI-генерацию).
# Без ключей приложение поднимется в no-AI режиме (флешкарты).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SPRING_AI_API_KEY=

# Какого провайдера использовать (openai | deepseek | spring-ai)
AI_PROVIDER=openai

# Разрешить on-demand AI-генерацию опций, если в БД нет seed-варианта.
# По умолчанию false: MCQ берутся из seed/mcq/<category>/<topic>.json.
# Включай только когда осознанно хочешь автоматический догенератор.
AI_FALLBACK_ENABLED=false

# Обязателен в prod-профиле — защищает админ-endpoints.
# Сгенерируй: openssl rand -hex 32
APP_ADMIN_TOKEN=

# CORS — список origin'ов через запятую
APP_CORS_ALLOWED_ORIGINS=https://localhost

# Лимит на регенерацию вопросов через AI (в минуту)
REGENERATE_RATE_LIMIT_PER_MINUTE=20

# Публикуемый порт на хосте
APP_PORT=8080

# Версия для тега образа
APP_VERSION=latest

# JVM-тюнинг (по умолчанию G1 + heap до 75% контейнерной памяти)
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC

# --- PostgreSQL (единственная поддерживаемая БД) ---
# docker compose поднимает postgres сам, эти переменные нужны если хочешь
# другие creds / порт / БД-имя.
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_PORT=5432

# --- Пересборка контента ---
# true → при следующем старте приложение TRUNCATE-нёт вопросы и опции и
# перечитает всё из cheatsheets/interview/**.md + seed/mcq/**.json.
# Удобно после массовой правки слагов/удаления файлов. По умолчанию false.
INTERVIEW_RESET_ON_STARTUP=false

# --- Hikari connection pool ---
# Дефолты подходят для laptop-dev (10/2). В проде с >5 параллельных юзеров
# подними max, иначе будут TimeoutException на pool.acquire.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Actuator (наблюдаемость) ---
# По умолчанию открыты только /health и /info. Чтобы включить /metrics
# и видеть детали health-компонентов (seedCoverage и т.п.):
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
