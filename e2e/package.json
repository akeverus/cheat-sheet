{
  "name": "cheat-sheet-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E (TEST-005 visual matrix, TEST-006 keyboard)",
  "scripts": {
    "test": "playwright test",
    "test:keyboard": "playwright test keyboard-quiz.spec.js",
    "test:visual": "playwright test visual-matrix.spec.js",
    "test:visual-golden": "VISUAL_GOLDEN=1 playwright test visual-matrix.spec.js",
    "test:visual-update": "VISUAL_GOLDEN=1 playwright test visual-matrix.spec.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
