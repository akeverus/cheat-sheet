# EditorConfig: https://editorconfig.org
# Поддерживается IntelliJ, VS Code, Cursor, vim — устраняет drift
# в indent/EOL между разработчиками.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown — trailing whitespace может быть значимым (двойной пробел = <br>),
# но в этом репо we don't rely on that, удаляем для чистоты.
[*.md]
indent_size = 2

# YAML — стандарт 2 пробела.
[*.{yml,yaml}]
indent_size = 2

# JSON — 2 пробела; mcq-схема и сидеры так выглядят.
[*.json]
indent_size = 2

# Shell — стандарт 4 пробела для читаемости.
[*.sh]
indent_size = 4

# Kotlin (Gradle DSL).
[*.{kt,kts}]
indent_size = 4

# Python — PEP 8.
[*.py]
indent_size = 4

# Не трогаем артефакты графа и build-output.
[graphify-out/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false

[**/build/**]
indent_style = unset
indent_size = unset
